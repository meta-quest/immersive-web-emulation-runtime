{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./lib",
    "noImplicitAny": false,
    // Captures are imported lazily from the package's captures/ folder at
    // runtime; resolving them here would copy every capture into lib/.
    "resolveJsonModule": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/generated/protos/validate.ts",
    "src/generated/google/protobuf/descriptor.ts"
  ]
}
