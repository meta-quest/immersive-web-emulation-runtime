{
  "name": "@iwer/native",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "ALPHA. Run an unmodified WebXR (IWSDK / three.js) bundle natively on Meta Quest and other Android OpenXR headsets, with no browser: prebuilt runtime template APK, packer/signer, compat checker and CLI. Not every web API is supported yet.",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "iwer-native": "bin/iwer-native.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "!lib/**/*.map",
    "!lib/**/*.d.ts.map",
    "packager/templates.json",
    "prebuilt/iwer-native-template.apk",
    "compat/data/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=4 --test-reporter=spec \"test/**/*.test.ts\" \"packager/test/**/*.test.ts\" \"compat/test/**/*.test.ts\"",
    "test:compat": "node --test --test-concurrency=4 --test-reporter=spec \"compat/test/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && npm run build && node bin/iwer-native.mjs --help",
    "release:notices": "node release/notices.mjs",
    "release:check": "node release/notices.mjs --check && node release/verify-third-party.mjs",
    "release:matrix": "node release/support-matrix.ts --write",
    "release:stage": "node release/stage-package.mjs"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  },
  "keywords": [
    "webxr",
    "openxr",
    "android",
    "iwer",
    "iwsdk",
    "native"
  ],
  "author": "Felix Zhang <fe1ix@meta.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta-quest/immersive-web-emulation-runtime.git",
    "directory": "packages/native"
  },
  "homepage": "https://github.com/meta-quest/immersive-web-emulation-runtime/tree/main/packages/native#readme",
  "bugs": {
    "url": "https://github.com/meta-quest/immersive-web-emulation-runtime/issues"
  }
}
