    {
      "from": "fonts/Roboto-Regular.ttf",
      "to": "iwn/fonts/Roboto-Regular.ttf",
      "compress": false
    },
    {
      "from": "fonts/Roboto-Bold.ttf",
      "to": "iwn/fonts/Roboto-Bold.ttf",
      "compress": false
    },
    {
      "from": "fonts/RobotoMono-Regular.ttf",
      "to": "iwn/fonts/RobotoMono-Regular.ttf",
      "compress": false
    },
    { "from": "licenses/NOTICE.txt", "to": "iwn/licenses/canvas2d/NOTICE.txt" },
    {
      "from": "licenses/FreeType-FTL.txt",
      "to": "iwn/licenses/canvas2d/FreeType-FTL.txt"
    },
    {
      "from": "licenses/zlib-LICENSE.txt",
      "to": "iwn/licenses/canvas2d/zlib-LICENSE.txt"
    },
    {
      "from": "licenses/HarfBuzz-COPYING.txt",
      "to": "iwn/licenses/canvas2d/HarfBuzz-COPYING.txt"
    },
    {
      "from": "licenses/Unicode-License.txt",
      "to": "iwn/licenses/canvas2d/Unicode-License.txt"
    },
    {
      "from": "licenses/Brotli-LICENSE.txt",
      "to": "iwn/licenses/canvas2d/Brotli-LICENSE.txt"
    },
    {
      "from": "licenses/stb-LICENSE.txt",
      "to": "iwn/licenses/canvas2d/stb-LICENSE.txt"
    },
    {
      "from": "fonts/OFL-Roboto.txt",
      "to": "iwn/licenses/canvas2d/OFL-Roboto.txt"
    },
    {
      "from": "fonts/OFL-RobotoMono.txt",
      "to": "iwn/licenses/canvas2d/OFL-RobotoMono.txt"
    }
  ]
}
