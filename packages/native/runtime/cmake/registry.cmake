# Native module registry (NATIVE MODULE CONTRACT).
#
# Collects the modules added with add_subdirectory() and generates iwn_module_registry.cc, a table of
# { "<module>", &iwn_register_<module> } that the core walks when it creates a JS context. On Android the app
# library links every module target; on the host nothing is generated (no V8 there).
#
# A module is found by either
#   1. set_property(GLOBAL APPEND PROPERTY IWN_NATIVE_MODULES "<module>:<target>") in its CMakeLists.txt, or
#   2. a library target named iwn_<dir> in a subdirectory runtime/<dir>/ (the convention).
# "core" and "app" are not modules.

function(iwn_finalize_native_modules)
  get_property(_declared GLOBAL PROPERTY IWN_NATIVE_MODULES)
  set(_names "")
  set(_targets "")
  foreach(_entry IN LISTS _declared)
    string(REPLACE ":" ";" _pair "${_entry}")
    list(GET _pair 0 _name)
    list(GET _pair 1 _target)
    if(NOT _name IN_LIST _names)
      list(APPEND _names ${_name})
      list(APPEND _targets ${_target})
    endif()
  endforeach()

  get_property(_subdirs DIRECTORY "${IWN_RUNTIME_DIR}" PROPERTY SUBDIRECTORIES)
  foreach(_dir IN LISTS _subdirs)
    get_filename_component(_name "${_dir}" NAME)
    if(_name STREQUAL "core" OR _name STREQUAL "app" OR _name IN_LIST _names)
      continue()
    endif()
    if(TARGET iwn_${_name})
      get_target_property(_type iwn_${_name} TYPE)
      if(_type MATCHES "LIBRARY")
        list(APPEND _names ${_name})
        list(APPEND _targets iwn_${_name})
      endif()
    endif()
  endforeach()

  # IWN_MODULES_EXCLUDE also applies to modules added with a plain add_subdirectory(): they still configure, but
  # the app neither links nor registers them (build the app target alone to skip compiling them).
  set(_kept_names "")
  set(_kept_targets "")
  list(LENGTH _names _n_all)
  if(_n_all GREATER 0)
    math(EXPR _last_all "${_n_all} - 1")
    foreach(_i RANGE ${_last_all})
      list(GET _names ${_i} _n)
      list(GET _targets ${_i} _t)
      if(NOT _n IN_LIST IWN_MODULES_EXCLUDE)
        list(APPEND _kept_names ${_n})
        list(APPEND _kept_targets ${_t})
      endif()
    endforeach()
  endif()
  set(_names "${_kept_names}")
  set(_targets "${_kept_targets}")

  set(_decls "")
  set(_rows "")
  list(LENGTH _names _count)
  if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_i RANGE ${_last})
      list(GET _names ${_i} _n)
      string(APPEND _decls "void iwn_register_${_n}(v8::Isolate*, v8::Local<v8::Context>, v8::Local<v8::Object>);\n")
      string(APPEND _rows "    {\"${_n}\", &iwn_register_${_n}},\n")
    endforeach()
  endif()

  set(IWN_NATIVE_MODULE_NAMES "${_names}" CACHE INTERNAL "registered native modules")
  set(IWN_NATIVE_MODULE_TARGETS "${_targets}" CACHE INTERNAL "registered native module targets")
  message(STATUS "iwer-native modules: ${_names}")

  if(IWN_ANDROID)
    set(_out "${CMAKE_BINARY_DIR}/generated/iwn_module_registry.cc")
    file(CONFIGURE OUTPUT "${_out}" CONTENT "// Generated by runtime/cmake/registry.cmake. Do not edit.
#include <v8.h>
#include \"iwn/core/module_registry.h\"

@_decls@
namespace iwn {
const NativeModuleEntry kNativeModules[] = {
@_rows@    {nullptr, nullptr},
};
const int kNativeModuleCount = ${_count};
}  // namespace iwn
" @ONLY)
    set(IWN_MODULE_REGISTRY_SOURCE "${_out}" CACHE INTERNAL "generated registry source")
  endif()
endfunction()
