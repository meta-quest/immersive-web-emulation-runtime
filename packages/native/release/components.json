{
  "//": [
    "Release inventory of third-party components. One entry per component that is bundled into",
    "the template APK (ships: apk), into a JS prelude inside it (ships: prelude), or used only by tests/host builds",
    "(ships: no). verify-third-party.mjs detects what the build actually bundles (CMake source dirs, vendored",
    "third_party/ dirs, APK libraries, web/<area> npm dependencies and esbuild metafiles, bundled fonts) and requires",
    "every detected item to map to an entry here AND to be named in THIRD_PARTY.md. notices.mjs turns the shipped",
    "entries into THIRD_PARTY_NOTICES.txt. Placeholders in notice paths: ${PKG} (packages/native), ${THIRD_PARTY}",
    "($IWN_THIRD_PARTY_DIR, the upstream source trees), ${V8_SRC} ($IWN_V8_SRC, the V8 15.5.35.25 source tree).",
    "'mit' / 'statement' notices are rendered from 'copyright' lines (the MIT text",
    "is taken from this package's LICENSE)."
  ],
  "detectIgnore": {
    "cmakeVars": ["IWN_TOOLCHAIN_DIR", "IWN_THIRD_PARTY_DIR", "IWN_RUNTIME_DIR", "IWN_AUDIO_DIR", "IWN_GL_DIR", "IWN_V8_INCLUDE_DIR", "IWN_V8_DIR"],
    "cmakeVarsTestOnly": ["IWN_NODE_API_INCLUDE_DIR"],
    "npmFirstParty": ["iwer"]
  },
