// Rug and coffee table.
const RUG_W = 2.5;
const RUG_D = 1.8;
const RUG_Z = Z0 + 1.45;
const coffee = group(0, 0, Z0 + 1.45);
{
  const top = mesh(roundedBox(1.15, 0.035, 0.6, 0.015), walnutMaterial, [0, 0.42, 0], coffee);
  top.userData.xrPlane = 'table';
  mesh(roundedBox(1.05, 0.02, 0.5, 0.008), walnutMaterial, [0, 0.12, 0], coffee);
  for (const x of [-0.54, 0.54]) {
    for (const z of [-0.26, 0.26]) {
      mesh(roundedBox(0.032, 0.4, 0.032, 0.008), blackMetal, [x, 0.2, z], coffee);
    }
  }
  const lower = box([0.28, 0.035, 0.21], standard({ color: '#2f3e46', roughness: 0.8 }), [-0.3, 0.454, 0.04], coffee);
  lower.rotation.y = 0.12;
  const upper = box([0.24, 0.028, 0.18], standard({ color: '#e2dacb', roughness: 0.8 }), [-0.29, 0.486, 0.045], coffee);
  upper.rotation.y = -0.06;
  const bowl = mesh(
    own(new THREE.SphereGeometry(0.13, 40, 12, 0, Math.PI * 2, Math.PI / 2, Math.PI / 2)),
    standard({ color: '#3b3a37', roughness: 0.5, side: THREE.DoubleSide }),
    [0.3, 0.495, -0.03],
    coffee,
  );
  bowl.scale.y = 0.5;
  mesh(own(new THREE.SphereGeometry(0.035, 16, 12)), standard({ color: '#d39a3a', roughness: 0.6 }), [0.28, 0.465, -0.02], coffee);
  mesh(own(new THREE.SphereGeometry(0.035, 16, 12)), standard({ color: '#8fa35a', roughness: 0.6 }), [0.33, 0.465, -0.06], coffee);
  mesh(own(new THREE.CylinderGeometry(0.035, 0.045, 0.15, 32)), ceramic, [0.08, 0.512, 0.17], coffee);
  volume('table', [1.15, 0.44, 0.6], [0, 0.22, 0], coffee, 0.45);
}

// Armchair angled towards the coffee table, by the window.
const chair = group(-1.75, 0, -1.25, 1.0);
{
  mesh(roundedBox(0.78, 0.28, 0.8, 0.06, 0.008), chairMaterial, [0, 0.29, 0], chair);
  mesh(roundedBox(0.66, 0.12, 0.62, 0.05, 0.022, 8), chairMaterial, [0, 0.48, 0.06], chair);
  mesh(roundedBox(0.78, 0.5, 0.14, 0.06, 0.008), chairMaterial, [0, 0.65, -0.33], chair).rotation.x = -0.14;
  for (const s of [-1, 1]) {
    mesh(roundedBox(0.1, 0.22, 0.74, 0.045), chairMaterial, [s * 0.36, 0.55, 0.02], chair);
    for (const z of [-0.32, 0.32]) {
      mesh(roundedBox(0.035, 0.16, 0.035, 0.012), walnutMaterial, [s * 0.32, 0.08, z], chair).rotation.z = s * 0.12;
    }
  }
  volume('couch', [0.8, 0.9, 0.82], [0, 0.45, 0], chair, 0.6);
}

// Fiddle-leaf fig in the front-left corner: a bare trunk, a few short
// branches, and large near-horizontal leaves clustered towards the top.
const plant = group(X0 + 0.38, 0, 0.35);
{
  mesh(own(new THREE.CylinderGeometry(0.19, 0.155, 0.38, 48)), potMaterial, [0, 0.19, 0], plant);
  mesh(own(new THREE.TorusGeometry(0.185, 0.012, 10, 48)), potMaterial, [0, 0.38, 0], plant).rotation.x = Math.PI / 2;
  mesh(own(new THREE.CylinderGeometry(0.178, 0.178, 0.01, 32)), soil, [0, 0.355, 0], plant);
  const bark = standard({ color: '#5b4835', roughness: 0.9 });
  mesh(own(new THREE.CylinderGeometry(0.014, 0.026, 1.5, 8).translate(0, 0.75, 0)), bark, [0, 0.36, 0], plant);

  // Leaf geometry: +Y along the leaf, cupped along the midrib.
  const leafGeometry = own(new THREE.PlaneGeometry(0.28, 0.38, 4, 6));
  const lp = leafGeometry.getAttribute('position');
  for (let i = 0; i < lp.count; i++) {
    const x = lp.getX(i);
    const y = lp.getY(i) + 0.19;
    lp.setXYZ(i, x, y + 0.04, Math.abs(x) * 0.3 - Math.pow(y / 0.38, 2) * 0.05);
  }
  leafGeometry.computeVertexNormals();

  // Branches: [height on trunk, yaw, length].
  const branches: [number, number, number][] = [
    [1.05, 0.6, 0.42],
    [1.25, 2.6, 0.38],
    [1.45, 4.4, 0.34],
    [1.62, 1.6, 0.26],
  ];
  const twig = own(new THREE.CylinderGeometry(0.007, 0.011, 1, 6).translate(0, 0.5, 0));
  const anchors: { at: THREE.Vector3; yaw: number }[] = [];
  for (const [height, yaw, length] of branches) {
    const start = new THREE.Vector3(0, height, 0);
    const direction = new THREE.Vector3(Math.sin(yaw) * 0.75, 0.66, Math.cos(yaw) * 0.75).normalize();
    const branch = mesh(twig, bark, [start.x, start.y, start.z], plant);
    branch.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction);
    branch.scale.set(1, length, 1);
    for (let k = 1; k <= 4; k++) {
      anchors.push({ at: start.clone().addScaledVector(direction, (length * k) / 4), yaw });
    }
  }
  for (let k = 0; k < 12; k++) {
    anchors.push({ at: new THREE.Vector3(0.02, 1.0 + k * 0.075, 0.01), yaw: k * 2.39996 });
  }

  const count = anchors.length * 2;
  const leaves = new THREE.InstancedMesh(leafGeometry, leafMaterial, count);
  leaves.castShadow = leaves.receiveShadow = true;
  const matrix = new THREE.Matrix4();
  const rotation = new THREE.Quaternion();
  const euler = new THREE.Euler();
  const color = new THREE.Color();
  let index = 0;
  for (const [a, { at, yaw }] of anchors.entries()) {
    for (const side of [-1, 1]) {
      const leafYaw = yaw + side * (0.5 + hash(a, side + 2, 3) * 0.6);
      // Near horizontal, drooping a little more the further out it is.
      // About a third of the leaves droop below horizontal.
      const droop = hash(a, side + 2, 8) < 0.3;
      const pitch = droop ? -1.65 - hash(a, side + 2, 1) * 0.3 : -0.85 - hash(a, side + 2, 1) * 0.55;
      euler.set(pitch, leafYaw, (hash(a, side + 2, 5) - 0.5) * 0.88, 'YXZ');
      rotation.setFromEuler(euler);
      const s = 0.6 + hash(a, side + 2, 2) * 0.6;
      matrix.compose(at, rotation, new THREE.Vector3(s, s, s));
      leaves.setMatrixAt(index, matrix);
      // Window side (-X) leaves are lighter and yellower; inner ones darker.
      const toWindow = Math.max(0, -Math.sin(leafYaw));
      const lit = 0.6 + 0.3 * hash(a, side + 2, 6) + 0.25 * toWindow;
      color.setRGB(lit * (1 + 0.12 * toWindow), lit, lit * 0.85);
      leaves.setColorAt(index, color);
      index++;
    }
  }
  plant.add(leaves);
  volume('plant', [0.75, 1.95, 0.75], [0, 0.97, 0], plant, 0.4);
}

// Media console and wall-mounted TV on the right wall.
const media = group(X1 - 0.22, 0, -1.4, -Math.PI / 2);
{
  mesh(roundedBox(1.9, 0.44, 0.42, 0.01), walnutMaterial, [0, 0.3, 0], media);
  const slat = own(new THREE.BoxGeometry(0.02, 0.36, 0.012));
  const slats = new THREE.InstancedMesh(slat, darkWalnut, 62);
  const m = new THREE.Matrix4();
  for (let i = 0; i < 62; i++) {
    slats.setMatrixAt(i, m.makeTranslation(-0.915 + 0.03 * i, 0.3, 0.214));
  }
  slats.receiveShadow = true;
  media.add(slats);
  for (const x of [-0.88, 0.88]) {
    for (const z of [-0.16, 0.16]) {
      mesh(own(new THREE.CylinderGeometry(0.014, 0.01, 0.08, 8)), blackMetal, [x, 0.04, z], media);
    }
  }
  mesh(own(new THREE.CylinderGeometry(0.05, 0.065, 0.26, 32)), stoneware, [-0.72, 0.65, 0.02], media);
  mesh(own(new THREE.CylinderGeometry(0.004, 0.004, 0.3, 4)), standard({ color: '#6b5a40' }), [-0.72, 0.9, 0.02], media).rotation.z = 0.15;
  const speaker = box([0.12, 0.19, 0.12], standard({ color: '#2a2a2a', roughness: 0.7 }), [0.74, 0.615, 0], media);
  speaker.rotation.y = 0.25;
  box([0.3, 0.04, 0.22], standard({ color: '#7a3b2e', roughness: 0.8 }), [0.3, 0.54, 0.02], media);
  volume('shelf', [1.9, 0.52, 0.42], [0, 0.26, 0], media, 0.75);
}
const tv = group(X1 - 0.03, 1.3, -1.4, -Math.PI / 2);
{
  box([1.46, 0.84, 0.028], standard({ color: '#0a0a0a', roughness: 0.35, metalness: 0.5 }), [0, 0, 0], tv);
  const screen = mesh(unitPlane, screenMaterial, [0, 0, 0.0145], tv, { cast: false });
  screen.scale.set(1.43, 0.81, 1);
  screen.userData.xrPlane = 'screen';
  volume('screen', [1.46, 0.84, 0.04], [0, 0, 0], tv, 0.3);
}

// Bookshelf on the right wall, towards the front.
const shelf = group(X1 - 0.18, 0, 0.7, -Math.PI / 2);
{
  const width = 0.9;
  const height = 1.9;
  for (const x of [-width / 2, width / 2]) mesh(roundedBox(0.025, height, 0.34, 0.004, 0, 8), walnutMaterial, [x, height / 2, 0], shelf);
  box([width, height, 0.012], darkWalnut, [0, height / 2, -0.164], shelf);
  const levels = [0.05, 0.43, 0.81, 1.19, 1.57, 1.89];
  for (const y of levels) mesh(roundedBox(width, 0.025, 0.34, 0.004, 0, 2), walnutMaterial, [0, y, 0], shelf);
  const palette = ['#2f3e46', '#b08d57', '#e3dccf', '#7a3b2e', '#55624a', '#cbb79a', '#3c3c3c', '#8c4f3b'];
  const books = new THREE.InstancedMesh(own(new THREE.BoxGeometry(1, 1, 1)), bookMaterial, 120);
  books.castShadow = books.receiveShadow = true;
  const matrix = new THREE.Matrix4();
  const rotation = new THREE.Quaternion();
  const color = new THREE.Color();
  let count = 0;
  for (let level = 0; level < 5; level++) {
    let x = -width / 2 + 0.02;
    const y = levels[level] + 0.0125;
    const end = level % 2 ? 0.12 : width / 2 - 0.02;
    while (x < end - 0.03 && count < 120) {
      const thickness = 0.018 + hash(count, 5, 5) * 0.03;
      const height = 0.19 + hash(count, 6, 6) * 0.11;
      const depth = 0.17 + hash(count, 7, 7) * 0.07;
      rotation.setFromAxisAngle(new THREE.Vector3(0, 0, 1), x + thickness > end - 0.05 ? -0.18 : 0);
      matrix.compose(new THREE.Vector3(x + thickness / 2, y + height / 2, 0.03), rotation, new THREE.Vector3(thickness, height, depth));
      books.setMatrixAt(count, matrix);
      color.set(palette[Math.floor(hash(count, 8, 8) * palette.length)]);
      books.setColorAt(count, color.multiplyScalar(0.8 + hash(count, 9, 9) * 0.3));
      x += thickness + 0.0015;
      count++;
    }
  }
  books.count = count;
  shelf.add(books);
  mesh(own(new THREE.SphereGeometry(0.07, 32, 20)), ceramic, [0.28, levels[1] + 0.08, 0], shelf);
  mesh(own(new THREE.CylinderGeometry(0.05, 0.035, 0.18, 24)), terracotta, [0.26, levels[3] + 0.1, 0], shelf);
  box([0.24, 0.3, 0.02], blackMetal, [0.05, levels[4] + 0.16, -0.12], shelf).rotation.x = -0.08;
  volume('shelf', [width, height, 0.34], [0, height / 2, 0], shelf, 0.7);
}

// Front wall: door, console table with mirror, basket.
const door = group(1.45, 0, Z1, Math.PI);
{
  // A dark backing shows as a 3 mm gap around the slab.
  box([0.86, 2.065, 0.01], standard({ color: '#3a3836', roughness: 1 }), [0, 1.0325, 0.005], door);
  const slab = mesh(roundedBox(0.854, 2.056, 0.04, 0.004, 0, 2), trimMaterial, [0, 1.028, 0.022], door);
  slab.userData.xrPlane = 'door';
  for (const [w, h, x, y] of [
    [0.07, 2.13, -0.465, 1.065],
    [0.07, 2.13, 0.465, 1.065],
    [1.0, 0.07, 0, 2.095],
  ] as const) {
    box([w, h, 0.022], trimMaterial, [x, y, 0.011], door);
  }
  box([0.025, 0.12, 0.012], brass, [0.36, 1.0, 0.05], door);
  mesh(own(new THREE.CylinderGeometry(0.012, 0.012, 0.12, 12)), brass, [0.32, 1.02, 0.07], door).rotation.z = Math.PI / 2;
}
const entry = group(-0.7, 0, Z1, Math.PI);
{
  mesh(roundedBox(1.1, 0.03, 0.32, 0.008), walnutMaterial, [0, 0.8, 0.17], entry);
  for (const x of [-0.52, 0.52]) {
    for (const z of [0.04, 0.3]) mesh(roundedBox(0.025, 0.79, 0.025, 0.006), blackMetal, [x, 0.395, z], entry);
  }
  const mirror = mesh(own(new THREE.CircleGeometry(0.36, 64)), mirrorMaterial, [0, 1.45, 0.012], entry, { cast: false });
  mirror.rotation.y = -0.09; // turned slightly towards the bright window side
  mirror.userData.xrPlane = 'wall art';
  mesh(own(new THREE.TorusGeometry(0.37, 0.012, 12, 96)), brass, [0, 1.45, 0.014], entry);
  mesh(own(new THREE.CylinderGeometry(0.06, 0.09, 0.3, 32)), ceramic, [-0.32, 0.965, 0.17], entry);
  mesh(own(new THREE.CylinderGeometry(0.17, 0.14, 0.3, 32, 1, true)), standard({ color: '#b8996b', roughness: 1, side: THREE.DoubleSide }), [0.25, 0.15, 0.25], entry);
  volume('table', [1.1, 0.82, 0.34], [0, 0.41, 0.17], entry, 0.45);
}

// Dining nook behind the viewer: round oak table with two chairs.
const dining = group(-0.95, 0, 1.35);
{
  const oakTop = standard({ map: oak.map, roughness: 0.5 });
  const chairOak = standard({ map: oak.map, color: '#d9c0a5', roughness: 0.55 });
  const top = mesh(own(new THREE.CylinderGeometry(0.45, 0.45, 0.03, 64)), oakTop, [0, 0.74, 0], dining);
  top.userData.xrPlane = 'table';
  mesh(own(new THREE.CylinderGeometry(0.04, 0.05, 0.71, 24)), blackMetal, [0, 0.365, 0], dining);
  mesh(own(new THREE.CylinderGeometry(0.24, 0.26, 0.02, 48)), blackMetal, [0, 0.01, 0], dining);
  mesh(own(new THREE.CylinderGeometry(0.06, 0.04, 0.2, 32)), stoneware, [0.08, 0.855, -0.05], dining);
  volume('table', [0.9, 0.76, 0.9], [0, 0.38, 0], dining, 0.45);
  for (const [angle, seed] of [
    [0.4, 1],
    [Math.PI + 0.25, 2],
  ]) {
    const chair = new THREE.Group();
    chair.position.set(Math.sin(angle) * 0.62, 0, Math.cos(angle) * 0.62);
    chair.rotation.y = angle + Math.PI + (seed - 1.5) * 0.15;
    dining.add(chair);
    mesh(roundedBox(0.44, 0.03, 0.42, 0.012), chairOak, [0, 0.45, 0], chair);
    const back = mesh(roundedBox(0.42, 0.16, 0.025, 0.01), chairOak, [0, 0.76, -0.2], chair);
    back.rotation.x = 0.1;
    for (const x of [-0.19, 0.19]) {
      for (const z of [-0.18, 0.18]) {
        const height = z < 0 ? 0.84 : 0.44;
        mesh(roundedBox(0.025, height, 0.025, 0.008), chairOak, [x, height / 2, z], chair);
      }
    }
    chair.updateWorldMatrix(true, false);
    volume('other', [0.44, 0.85, 0.42], [0, 0.425, 0], chair, 0.4);
  }
}
// Doormat inside the door.
box([0.75, 0.008, 0.45], standard({ color: '#6e5a44', roughness: 1, ...fabric(56), bumpScale: 1.5 }), [1.45, 0.004, Z1 - 0.4]);

// Floor lamp (switched off) at the right end of the sofa.
const floorLamp = group(1.55, 0, Z0 + 0.3);
{
  mesh(own(new THREE.CylinderGeometry(0.14, 0.15, 0.02, 40)), blackMetal, [0, 0.01, 0], floorLamp);
  mesh(own(new THREE.CylinderGeometry(0.009, 0.009, 1.45, 10)), blackMetal, [0, 0.74, 0], floorLamp);
  const linen = standard({ color: '#d8d0c2', roughness: 0.9, side: THREE.DoubleSide });
  mesh(own(new THREE.CylinderGeometry(0.2, 0.2, 0.3, 48, 1, true)), linen, [0, 1.55, 0], floorLamp);
  const diffuser = mesh(own(new THREE.CircleGeometry(0.19, 40)), standard({ color: '#cfc7b8', roughness: 1 }), [0, 1.67, 0], floorLamp, { cast: false });
  diffuser.rotation.x = Math.PI / 2;
  volume('lamp', [0.4, 1.72, 0.4], [0, 0.86, 0], floorLamp, 0.4);
}

// Large botanical print on the left wall by the dining nook.
const print = group(X0, 1.5, 1.35, Math.PI / 2);
{
  const canvas = document.createElement('canvas');
  canvas.width = 400;
  canvas.height = 600;
  const ctx = canvas.getContext('2d')!;
  ctx.fillStyle = '#efe9de';
  ctx.fillRect(0, 0, 400, 600);
  ctx.strokeStyle = '#3d4a3a';
  ctx.lineWidth = 3;
  ctx.lineCap = 'round';
  // A stem with alternating leaf outlines.
  ctx.beginPath();
  ctx.moveTo(200, 560);
  ctx.bezierCurveTo(190, 420, 230, 260, 205, 60);
  ctx.stroke();
  for (let i = 0; i < 7; i++) {
    const y = 500 - i * 62;
    const side = i % 2 ? 1 : -1;
    const x = 200 + Math.sin(i) * 8;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.quadraticCurveTo(x + side * 90, y - 70, x + side * 120, y - 20);
    ctx.quadraticCurveTo(x + side * 70, y + 10, x, y);
    ctx.stroke();
  }
  const tex = own(new THREE.CanvasTexture(canvas));
  tex.colorSpace = THREE.SRGBColorSpace;
  box([0.64, 0.94, 0.025], walnutMaterial, [0, 0, 0.0125], print);
  mesh(unitPlane, trimMaterial, [0, 0, 0.0255], print, { cast: false }).scale.set(0.6, 0.9, 1);
  const art = mesh(unitPlane, standard({ map: tex, roughness: 0.9 }), [0, 0, 0.026], print, { cast: false });
  art.scale.set(0.44, 0.66, 1);
  art.userData.xrPlane = 'wall art';
}

// Light switch by the door and a few sockets.
{
  const plate = standard({ color: '#f4f2ee', roughness: 0.4 });
  const switchPlate = box([0.085, 0.085, 0.01], plate, [0.85, 1.1, Z1 - 0.005], scene);
  switchPlate.rotation.y = Math.PI;
  box([0.025, 0.035, 0.006], plate, [0.85, 1.1, Z1 - 0.012], scene);
  for (const [x, z, rotation] of [
    [-1.15, Z0 + 0.005, 0],
    [X1 - 0.005, -0.45, -Math.PI / 2],
    [X0 + 0.005, 1.4, Math.PI / 2],
  ] as const) {
    const socket = box([0.085, 0.085, 0.01], plate, [x, 0.3, z], scene);
    socket.rotation.y = rotation;
  }
}

// ------------------------------------------------------------------- shell

function shell(geometry: THREE.BufferGeometry, material: THREE.MeshStandardMaterial, position: Vec3, rotation: [number, number], label: string, w: number, h: number) {
  const object = mesh(geometry, material, position, scene, { cast: label !== 'floor' });
  object.rotation.set(rotation[0], rotation[1], 0);
  object.userData.xrPlane = label;
  material.lightMap = bakeLightmap(object, w, h);
  return object;
}

const wallParams = { color: '#eeeae3', roughness: 0.9, bumpMap: plasterBump, bumpScale: 0.12 };
shell(panel(W, D), customizeEnvironment(shellMaterial({ ...oak, bumpScale: 0.15, roughness: 1, envMapIntensity: 0.5 }), { boxProjected: true, specularOnly: true }), [0, 0, ZC], [-Math.PI / 2, 0], 'floor', W, D);
shell(panel(W, D), shellMaterial({ color: '#f7f4ef', roughness: 0.95 }), [0, H, ZC], [Math.PI / 2, 0], 'ceiling', W, D);
const windowLocalX = -(WINDOW_Z - ZC);
// Walls overlap the floor, ceiling and each other slightly so no seam
// shows a hairline.
const SEAM = 0.004;
shell(
  panel(D + SEAM, H + SEAM, [[windowLocalX - WINDOW_WIDTH / 2, SILL - H / 2, windowLocalX + WINDOW_WIDTH / 2, HEAD - H / 2]]),
  shellMaterial(wallParams),
  [X0, H / 2, ZC],
  [0, Math.PI / 2],
  'wall',
  D + SEAM,
  H + SEAM,
);
shell(panel(D + SEAM, H + SEAM), shellMaterial(wallParams), [X1, H / 2, ZC], [0, -Math.PI / 2], 'wall', D + SEAM, H + SEAM);
shell(panel(W + SEAM, H + SEAM), shellMaterial(wallParams), [0, H / 2, Z0], [0, 0], 'wall', W + SEAM, H + SEAM);
shell(panel(W + SEAM, H + SEAM), shellMaterial(wallParams), [0, H / 2, Z1], [0, Math.PI], 'wall', W + SEAM, H + SEAM);

// Shadow-only shell: thick boxes around the room (with the window opening),
// reaching 3 cm into it, so no sunlight leaks in where the thin wall and
// ceiling planes meet. They write neither color nor depth and ignore
// hit-test rays.
{
  const caster = own(new THREE.MeshBasicMaterial({ colorWrite: false, depthWrite: false }));
  // Front faces must cast too, so points just inside a slab are shadowed.
  caster.shadowSide = THREE.DoubleSide;
  const slab = (min: Vec3, max: Vec3) => {
    const size: Vec3 = [max[0] - min[0], max[1] - min[1], max[2] - min[2]];
    const object = box(size, caster, [(min[0] + max[0]) / 2, (min[1] + max[1]) / 2, (min[2] + max[2]) / 2]);
    object.receiveShadow = false;
    object.userData.shadowOnly = true;
  };
  const t = 0.2;
  const inset = 0.03;
  const zw0 = WINDOW_Z - WINDOW_WIDTH / 2;
  const zw1 = WINDOW_Z + WINDOW_WIDTH / 2;
  slab([X0 - 0.4, H - inset, Z0 - 0.4], [X1 + 0.4, H + t, Z1 + 0.4]);
  slab([X1 - inset, -0.1, Z0 - 0.4], [X1 + t, H + t, Z1 + 0.4]);
  slab([X0 - 0.4, -0.1, Z0 - t], [X1 + 0.4, H + t, Z0 + inset]);
  slab([X0 - 0.4, -0.1, Z1 - inset], [X1 + 0.4, H + t, Z1 + t]);
  // Left wall, outside the window reveal, around the opening.
  const x0 = X0 - 0.2 - t;
  const x1 = X0 - 0.2;
  slab([x0, -0.1, Z0 - 0.4], [x1, SILL, Z1 + 0.4]);
  slab([x0, HEAD, Z0 - 0.4], [x1, H + t, Z1 + 0.4]);
  slab([x0, SILL, Z0 - 0.4], [x1, HEAD, zw0]);
  slab([x0, SILL, zw1], [x1, HEAD, Z1 + 0.4]);
}

// Rug, lit like the floor beneath it.
{
  const rug = mesh(panel(RUG_W, RUG_D), shellMaterial({ map: fitted(rugCanvas(RUG_W, RUG_D), RUG_W, RUG_D), roughness: 1 }), [0, 0.006, RUG_Z], scene, { cast: false });
  rug.rotation.x = -Math.PI / 2;
  (rug.material as THREE.MeshStandardMaterial).lightMap = bakeLightmap(rug, RUG_W, RUG_D);
}

// Baseboards.
for (const [x, z, length, rotation] of [
  [X0, ZC, D, Math.PI / 2],
  [X1, ZC, D, -Math.PI / 2],
  [0, Z0, W, 0],
  [0, Z1, W, Math.PI],
] as const) {
  box([length, 0.09, 0.014], trimMaterial, [0, 0.045, 0.007], group(x, 0, z, rotation));
}

// Window: reveal, frame, glass, the view outside, sheers.
const win = group(X0, 0, WINDOW_Z, Math.PI / 2);
{
  const reveal = 0.16;
  const revealMaterial = shellMaterial({ ...wallParams, lightMapIntensity: 0 });
  revealMaterial.envMapIntensity = 0.6;
  box([0.02, HEAD - SILL, reveal], revealMaterial, [-WINDOW_WIDTH / 2 - 0.01, (SILL + HEAD) / 2, -reveal / 2], win);
  box([0.02, HEAD - SILL, reveal], revealMaterial, [WINDOW_WIDTH / 2 + 0.01, (SILL + HEAD) / 2, -reveal / 2], win);
  box([WINDOW_WIDTH, 0.02, reveal], revealMaterial, [0, HEAD + 0.01, -reveal / 2], win);
  box([WINDOW_WIDTH + 0.12, 0.03, reveal + 0.06], trimMaterial, [0, SILL - 0.015, -reveal / 2 + 0.03], win);
  const frameZ = -reveal + 0.04;
  box([WINDOW_WIDTH, 0.05, 0.06], trimMaterial, [0, SILL + 0.025, frameZ], win);
  box([WINDOW_WIDTH, 0.05, 0.06], trimMaterial, [0, HEAD - 0.025, frameZ], win);
  box([0.05, HEAD - SILL, 0.06], trimMaterial, [-WINDOW_WIDTH / 2 + 0.025, (SILL + HEAD) / 2, frameZ], win);
  box([0.05, HEAD - SILL, 0.06], trimMaterial, [WINDOW_WIDTH / 2 - 0.025, (SILL + HEAD) / 2, frameZ], win);
  box([0.06, HEAD - SILL, 0.06], trimMaterial, [0, (SILL + HEAD) / 2, frameZ], win);
  const glass = mesh(unitPlane, glassMaterial, [0, (SILL + HEAD) / 2, frameZ], win, { cast: false, receive: false });
  glass.scale.set(WINDOW_WIDTH, HEAD - SILL, 1);
  glass.userData.xrPlane = 'window';
  const view = mesh(unitPlane, outsideMaterial, [0, 1.3, -4], win, { cast: false, receive: false });
  view.scale.set(12, 6, 1);
  // Brass rod and gathered sheers.
  mesh(own(new THREE.CylinderGeometry(0.012, 0.012, WINDOW_WIDTH + 1, 12)), brass, [0, HEAD + 0.15, 0.1], win).rotation.z = Math.PI / 2;
  for (const [x, seed] of [
    [-WINDOW_WIDTH / 2 - 0.22, 1],
    [WINDOW_WIDTH / 2 + 0.22, 4],
  ]) {
    const height = HEAD + 0.13;
    const geometry = own(new THREE.PlaneGeometry(0.62, height, 72, 12));
    const position = geometry.getAttribute('position');
    const colors = new Float32Array(position.count * 3);
    for (let i = 0; i < position.count; i++) {
      const px = position.getX(i);
      const py = position.getY(i) / height + 0.5; // 0 bottom .. 1 top
      // ~11 cm folds with a slowly varying period; valleys are shaded.
      const phase = (px / 0.11) * Math.PI * 2 + Math.sin(px * 9 + seed) * 1.2;
      const fold = Math.sin(phase);
      position.setZ(i, fold * 0.03 * (0.8 + 0.2 * py));
      colors.fill(0.85 + 0.15 * (fold * 0.5 + 0.5), i * 3, i * 3 + 3);
    }
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    geometry.computeVertexNormals();
    mesh(geometry, curtainMaterial, [x, height / 2 + 0.02, 0.1], win, { cast: false });
  }
}

// Recessed downlights (off during the day): trim ring and lens.
const ringGeometry = own(new THREE.RingGeometry(0.045, 0.062, 32));
const lensGeometry = own(new THREE.CircleGeometry(0.045, 32));
const lensMaterial = standard({ color: '#dcd7ce', roughness: 0.3 });
for (const [x, z] of [
  [-1.1, -2.2],
  [1.1, -2.2],
  [-1.1, 0.6],
  [1.1, 0.6],
]) {
  mesh(ringGeometry, trimMaterial, [x, H - 0.002, z], scene, { cast: false }).rotation.x = Math.PI / 2;
  mesh(lensGeometry, lensMaterial, [x, H - 0.004, z], scene, { cast: false }).rotation.x = Math.PI / 2;
}

// Bake ambient occlusion into furniture as vertex colors (and instance
// colors): darker near the floor and next to other furniture. Directional
// light comes from the environment probe, so it is not baked here.
{
  const p = new THREE.Vector3();
  const n = new THREE.Vector3();
  const normalMatrix = new THREE.Matrix3();
  const shade = (y: number) => {
    const ao = occlusion(p, n, occluders.filter((o) => !inside(p, o)));
    const floor = n.y > 0.7 ? 1 : 1 - 0.35 * Math.exp(-y / 0.15);
    return THREE.MathUtils.clamp(0.55 + 0.45 * ao, 0.55, 1) * floor;
  };
  const skip = (material: THREE.Material) => {
    const m = material as THREE.MeshStandardMaterial;
    return !m.isMeshStandardMaterial || m === trimMaterial || m.transparent || !m.visible || m.lightMap || m.emissive.getHex() !== 0;
  };
  const seen = new Set<THREE.BufferGeometry>();
  const shaded = new Set<THREE.Material>();
  scene.updateMatrixWorld(true);
  scene.traverse((object) => {
    const target = object as THREE.Mesh;
    if (!target.isMesh || skip(target.material as THREE.Material)) return;
    shaded.add(target.material as THREE.Material);
    const instanced = object as THREE.InstancedMesh;
    if (instanced.isInstancedMesh) {
      const matrix = new THREE.Matrix4();
      const color = new THREE.Color();
      for (let i = 0; i < instanced.count; i++) {
        instanced.getMatrixAt(i, matrix);
        p.setFromMatrixPosition(matrix.premultiply(instanced.matrixWorld));
        n.set(0, 1, 0);
        const f = shade(p.y);
        if (instanced.instanceColor) instanced.getColorAt(i, color);
        else color.setRGB(1, 1, 1);
        instanced.setColorAt(i, color.multiplyScalar(f));
      }
      return;
    }
    if (seen.has(target.geometry)) target.geometry = own(target.geometry.clone());
    seen.add(target.geometry);
    const position = target.geometry.getAttribute('position');
    const normal = target.geometry.getAttribute('normal');
    const colors = new Float32Array(position.count * 3);
    normalMatrix.getNormalMatrix(target.matrixWorld);
    for (let i = 0; i < position.count; i++) {
      p.fromBufferAttribute(position, i).applyMatrix4(target.matrixWorld);
      n.fromBufferAttribute(normal, i).applyMatrix3(normalMatrix).normalize();
      colors.fill(shade(p.y), i * 3, i * 3 + 3);
    }
    target.geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  });
  shaded.forEach((material) => (material.vertexColors = true));
  // Shared materials on meshes without a color attribute get plain white.
  scene.traverse((object) => {
    const target = object as THREE.Mesh;
    if (!target.isMesh || !(target.material as THREE.Material).vertexColors) return;
    if (target.geometry.getAttribute('color')) return;
    const count = target.geometry.getAttribute('position').count;
    target.geometry.setAttribute('color', new THREE.BufferAttribute(new Float32Array(count * 3).fill(1), 3));
  });
}

// Merge static meshes that share a material into one draw call each.
// Labelled meshes stay separate so they remain WebXR planes / meshes.
{
  scene.updateMatrixWorld(true);
  const buckets = new Map<string, THREE.Mesh[]>();
  scene.traverse((object) => {
    const target = object as THREE.Mesh;
    if (!target.isMesh || (target as THREE.InstancedMesh).isInstancedMesh) return;
    const material = target.material as THREE.Material;
    if (!material.visible || material.transparent) return;
    if (target.userData.xrPlane || target.userData.xrMesh) return;
    const attributes = Object.keys(target.geometry.attributes).sort().join();
    const key = `${material.uuid}:${target.castShadow}:${target.receiveShadow}:${attributes}`;
    buckets.set(key, [...(buckets.get(key) ?? []), target]);
  });
  const normalMatrix = new THREE.Matrix3();
  for (const meshes of buckets.values()) {
    if (meshes.length < 2) continue;
    const names = Object.keys(meshes[0].geometry.attributes);
    const vertexCount = meshes.reduce((sum, m) => sum + m.geometry.getAttribute('position').count, 0);
    const arrays = Object.fromEntries(
      names.map((name) => [name, new Float32Array(vertexCount * meshes[0].geometry.getAttribute(name).itemSize)]),
    );
    const indices: number[] = [];
    let base = 0;
    for (const m of meshes) {
      const geometry = m.geometry.clone();
      geometry.applyMatrix4(m.matrixWorld);
      normalMatrix.getNormalMatrix(m.matrixWorld);
      for (const name of names) {
        const attribute = geometry.getAttribute(name);
        arrays[name].set(attribute.array as Float32Array, base * attribute.itemSize);
      }
      const index = geometry.getIndex();
      const count = geometry.getAttribute('position').count;
      if (index) for (let i = 0; i < index.count; i++) indices.push(index.getX(i) + base);
      else for (let i = 0; i < count; i++) indices.push(i + base);
      base += count;
      geometry.dispose();
      m.removeFromParent();
    }
    const merged = own(new THREE.BufferGeometry());
    for (const name of names) {
      merged.setAttribute(name, new THREE.BufferAttribute(arrays[name], meshes[0].geometry.getAttribute(name).itemSize));
    }
    merged.setIndex(indices);
    const combined = new THREE.Mesh(merged, meshes[0].material);
    if (meshes[0].userData.shadowOnly) combined.raycast = () => {};
    combined.castShadow = meshes[0].castShadow;
    combined.receiveShadow = meshes[0].receiveShadow;
    scene.add(combined);
  }
}

// Environment probe: an HDR equirect painted by ray casting the room from
// its center and shading each hit with the same baked irradiance, so
// reflections show the actual room, window and sun patch.
const PROBE = new THREE.Vector3(0, 1.3, ZC);
function roomEnvironment() {
  const width = 96;
  const height = 48;
  const data = new Float32Array(width * height * 4);
  const d = new THREE.Vector3();
  const hit = new THREE.Vector3();
  const n = new THREE.Vector3();
  const toWindow = new THREE.Vector3();
  const room = { min: new THREE.Vector3(X0, 0, Z0), max: new THREE.Vector3(X1, H, Z1), strength: 0 };
  const exit = (o: Occluder) => {
    let t = Infinity;
    for (const axis of ['x', 'y', 'z'] as const) {
      if (Math.abs(d[axis]) < 1e-6) continue;
      const bound = d[axis] > 0 ? o.max[axis] : o.min[axis];
      t = Math.min(t, (bound - PROBE[axis]) / d[axis]);
    }
    return t;
  };
  const entry = (o: Occluder) => {
    let near = -Infinity;
    let far = Infinity;
    for (const axis of ['x', 'y', 'z'] as const) {
      if (Math.abs(d[axis]) < 1e-6) {
        if (PROBE[axis] < o.min[axis] || PROBE[axis] > o.max[axis]) return Infinity;
        continue;
      }
      const a = (o.min[axis] - PROBE[axis]) / d[axis];
      const b = (o.max[axis] - PROBE[axis]) / d[axis];
      near = Math.max(near, Math.min(a, b));
      far = Math.min(far, Math.max(a, b));
    }
    return near > 0 && near <= far ? near : Infinity;
  };
  for (let y = 0; y < height; y++) {
    for (let x = 0; x < width; x++) {
      const phi = ((x + 0.5) / width - 0.5) * Math.PI * 2;
      const theta = ((y + 0.5) / height - 0.5) * Math.PI;
      d.set(Math.cos(theta) * Math.cos(phi), Math.sin(theta), Math.cos(theta) * Math.sin(phi));
      let t = exit(room);
      let albedo = [0, 0, 0];
      let furniture: Occluder | undefined;
      for (const o of occluders) {
        const te = entry(o);
        if (te < t) {
          t = te;
          furniture = o;
        }
      }
      hit.copy(PROBE).addScaledVector(d, t);
      // Inward normal of the face that was hit.
      const box = furniture ?? room;
      const sign = furniture ? 1 : -1;
      if (Math.abs(hit.x - box.min.x) < 1e-3) n.set(-sign, 0, 0);
      else if (Math.abs(hit.x - box.max.x) < 1e-3) n.set(sign, 0, 0);
      else if (Math.abs(hit.y - box.min.y) < 1e-3) n.set(0, -sign, 0);
      else if (Math.abs(hit.y - box.max.y) < 1e-3) n.set(0, sign, 0);
      else if (Math.abs(hit.z - box.min.z) < 1e-3) n.set(0, 0, -sign);
      else n.set(0, 0, sign);
      let rgb: number[];
      const inWindow =
        !furniture && n.x > 0.5 && hit.y > SILL && hit.y < HEAD && Math.abs(hit.z - WINDOW_Z) < WINDOW_WIDTH / 2;
      if (inWindow) {
        rgb = [3.2, 3.4, 3.6];
      } else {
        if (furniture) albedo = [0.3, 0.28, 0.26];
        else if (n.y > 0.5) albedo = [0.4, 0.27, 0.15];
        else if (n.y < -0.5) albedo = [0.9, 0.87, 0.83];
        else albedo = [0.82, 0.77, 0.69];
        const e = irradiance(hit, n);
        rgb = albedo.map((a, i) => (a * e[i] * LIGHTMAP_INTENSITY) / Math.PI);
        // Sunlit floor: trace back towards the sun through the window.
        if (!furniture && n.y > 0.5) {
          toWindow.copy(hit).addScaledVector(sunDirection, (X0 - hit.x) / sunDirection.x);
          if (toWindow.y > SILL && toWindow.y < HEAD && Math.abs(toWindow.z - WINDOW_Z) < WINDOW_WIDTH / 2) {
            const sun = (22 * -sunDirection.y * 0.45) / Math.PI;
            rgb = [rgb[0] + sun, rgb[1] + sun * 0.86, rgb[2] + sun * 0.67];
          }
        }
      }
      data.set([rgb[0], rgb[1], rgb[2], 1], (y * width + x) * 4);
    }
  }
  const tex = own(new THREE.DataTexture(data, width, height, THREE.RGBAFormat, THREE.FloatType));
  tex.mapping = THREE.EquirectangularReflectionMapping;
  tex.magFilter = THREE.LinearFilter;
  tex.needsUpdate = true;
  return tex;
}

// Environment shader tweaks:
// - boxProjected: the probe is parallax-corrected against the room box, so
//   the window reflects where it actually is.
// - specularOnly: lightmapped surfaces already have their diffuse light, so
//   they only take reflections from the probe.
function customizeEnvironment(
  material: THREE.MeshStandardMaterial,
  { boxProjected = false, specularOnly = false },
) {
  let chunk = THREE.ShaderChunk.envmap_physical_pars_fragment;
  if (boxProjected) {
    chunk = chunk.replace(
      'reflectVec = transformDirectionByInverseViewMatrix( reflectVec, viewMatrix );',
      `reflectVec = transformDirectionByInverseViewMatrix( reflectVec, viewMatrix );
      vec3 boxHit = mix( boxMin, boxMax, step( 0.0, reflectVec ) );
      vec3 boxT = ( boxHit - vBoxWorldPosition ) / reflectVec;
      float boxDistance = min( min( boxT.x, boxT.y ), boxT.z );
      reflectVec = normalize( vBoxWorldPosition + reflectVec * boxDistance - probePosition );`,
    );
  }
  if (specularOnly) {
    chunk = chunk.replace('return PI * envMapColor.rgb * envMapIntensity;', 'return vec3( 0.0 );');
  }
  material.onBeforeCompile = (shader) => {
    shader.uniforms.boxMin = { value: new THREE.Vector3(X0, 0, Z0) };
    shader.uniforms.boxMax = { value: new THREE.Vector3(X1, H, Z1) };
    shader.uniforms.probePosition = { value: PROBE };
    shader.vertexShader = shader.vertexShader
      .replace('#include <common>', '#include <common>\nvarying vec3 vBoxWorldPosition;')
      .replace(
        '#include <worldpos_vertex>',
        '#include <worldpos_vertex>\nvBoxWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;',
      );
    shader.fragmentShader = shader.fragmentShader
      .replace(
        '#include <common>',
        '#include <common>\nvarying vec3 vBoxWorldPosition;\nuniform vec3 boxMin;\nuniform vec3 boxMax;\nuniform vec3 probePosition;',
      )
      .replace('#include <envmap_physical_pars_fragment>', chunk);
  };
  material.customProgramCacheKey = () => `environment:${boxProjected}:${specularOnly}`;
  return material;
}

// ---------------------------------------------------------------- lighting

scene.background = new THREE.Color('#e6e1d8');
scene.environment = roomEnvironment();
scene.environmentIntensity = 1.2;

// Afternoon sun through the window: a static shadow, rendered once.
const sun = new THREE.DirectionalLight('#ffdcaa', 22);
// Aimed so the window's light patch lands on the rug and the armchair.
sun.target.position.copy(SUN_TARGET);
sun.position.copy(SUN_POSITION);
sun.castShadow = true;
sun.shadow.mapSize.set(2048, 2048);
// Fit the shadow frustum tightly around the room (outside it would be lit).
{
  const view = new THREE.Matrix4().lookAt(SUN_POSITION, SUN_TARGET, new THREE.Vector3(0, 1, 0));
  view.setPosition(SUN_POSITION).invert();
  const bounds = new THREE.Box3();
  for (const x of [X0 - 0.3, X1]) {
    for (const y of [0, H]) {
      for (const z of [Z0, Z1]) bounds.expandByPoint(new THREE.Vector3(x, y, z).applyMatrix4(view));
    }
  }
  Object.assign(sun.shadow.camera, {
    left: bounds.min.x - 0.05,
    right: bounds.max.x + 0.05,
    bottom: bounds.min.y - 0.05,
    top: bounds.max.y + 0.05,
    near: -bounds.max.z - 0.5,
    far: -bounds.min.z + 0.5,
  });
}
sun.shadow.bias = -0.0002;
sun.shadow.normalBias = 0.02;
sun.shadow.radius = 0.8;
sun.shadow.autoUpdate = false;
sun.shadow.needsUpdate = true;
scene.add(sun, sun.target);

scene.rendering.shadows = true;
scene.rendering.toneMapping = THREE.AgXToneMapping;
scene.rendering.toneMappingExposure = 0.95;

// ------------------------------------------------------------ robot vacuum

const robot = new THREE.Group();
robot.name = 'robot';
scene.add(robot);
{
  mesh(
    own(new THREE.CylinderGeometry(0.17, 0.17, 0.075, 48)),
    standard({ color: '#232325', roughness: 0.25, metalness: 0.1 }),
    [0, 0.045, 0],
    robot,
  );
  mesh(own(new THREE.TorusGeometry(0.17, 0.012, 8, 48)), standard({ color: '#4a4a4c', roughness: 0.6 }), [0, 0.03, 0], robot).rotation.x = Math.PI / 2;
  mesh(own(new THREE.CylinderGeometry(0.045, 0.045, 0.025, 32)), standard({ color: '#3a3a3c', roughness: 0.4 }), [0, 0.095, 0.06], robot);
  mesh(own(new THREE.CircleGeometry(0.008, 12)), bulbMaterial, [0.05, 0.0835, -0.1], robot, { cast: false }).rotation.x = -Math.PI / 2;
  // Soft contact shadow that travels with it.
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = 64;
  const ctx = canvas.getContext('2d')!;
  const gradient = ctx.createRadialGradient(32, 32, 24, 32, 32, 32);
  gradient.addColorStop(0, 'rgba(255,255,255,1)');
  gradient.addColorStop(1, 'rgba(255,255,255,0)');
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, 64, 64);
  const shadow = mesh(
    own(new THREE.PlaneGeometry(0.4, 0.4)),
    own(new THREE.MeshBasicMaterial({ color: 'black', alphaMap: own(new THREE.CanvasTexture(canvas)), transparent: true, opacity: 0.45, depthWrite: false })),
    [0, 0.008, 0],
    robot,
    { cast: false, receive: false },
  );
  shadow.rotation.x = -Math.PI / 2;
}
// An elliptical loop through the open floor between the sofa area and the
// dining nook.
let robotTime = 0;
function placeRobot() {
  const angle = robotTime * 0.35;
  robot.position.set(0.35 + Math.cos(angle) * 1.1, 0, 0.15 + Math.sin(angle) * 0.45);
  // Face along the path (the robot's front is -Z).
  robot.rotation.y = Math.atan2(Math.sin(angle) * 1.1, -Math.cos(angle) * 0.45);
}
placeRobot();
onFrame((delta) => {
  robotTime += delta;
  placeRobot();
});

