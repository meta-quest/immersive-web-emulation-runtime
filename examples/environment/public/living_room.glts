// A sunlit living room, IWER's default AR environment.
//
// Everything is procedural and offline: canvas textures, an HDR environment
// map, baked lightmaps (window light + ambient occlusion, computed
// analytically at load) and one static sun shadow. Meshes tagged with
// userData.xrPlane / userData.xrMesh become WebXR planes / meshes; invisible
// box proxies describe furniture volumes.
//
// Layout (meters, the viewer starts at the origin facing -Z):
//   back wall  (-Z)  sofa, wall art, side table with lamp, floor lamp
//   left wall  (-X)  window with sheers, armchair, fig tree
//   right wall (+X)  media console and TV, bookshelf
//   front wall (+Z)  door, console table with mirror, dining nook
//
// A robot vacuum drives loops across the open floor: a dynamic part of the
// "real world". Like on real devices it is not a tracked plane/mesh, but it
// is visible, hit-testable and in depth. It is added after the bake and merge
// passes so it stays a separate, movable object.
import * as THREE from 'three';
import { onDispose, onFrame, scene } from '@drawcall/glts';

const W = 5.0;
const D = 5.8;
const H = 2.7;
const X0 = -W / 2;
const X1 = W / 2;
const Z0 = -3.4;
const Z1 = Z0 + D;
const ZC = (Z0 + Z1) / 2;

// Baked lightmap values are irradiance / LIGHTMAP_INTENSITY.
const LIGHTMAP_INTENSITY = 2.4;

// Window in the left wall.
const WINDOW_Z = -1.35;
const WINDOW_WIDTH = 2.1;
const SILL = 0.55;
const HEAD = 2.35;

const owned: { dispose(): void }[] = [];
function own<T extends { dispose(): void }>(value: T): T {
  owned.push(value);
  return value;
}
onDispose(() => owned.forEach((value) => value.dispose()));

// ------------------------------------------------------------------ noise

function hash(x: number, y: number, seed: number) {
  let h =
    Math.imul(x | 0, 374761393) ^
    Math.imul(y | 0, 668265263) ^
    Math.imul(seed | 0, 982451653);
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
}

const mod = (a: number, n: number) => ((a % n) + n) % n;
const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
const mix = (a: number, b: number, t: number) => a + (b - a) * t;

// Value noise, tileable with integer periods px / py.
function noise(x: number, y: number, seed: number, px: number, py: number) {
  const ix = Math.floor(x);
  const iy = Math.floor(y);
  const fx = x - ix;
  const fy = y - iy;
  const ux = fx * fx * (3 - 2 * fx);
  const uy = fy * fy * (3 - 2 * fy);
  const x0 = mod(ix, px);
  const x1 = mod(ix + 1, px);
  const y0 = mod(iy, py);
  const y1 = mod(iy + 1, py);
  const a = hash(x0, y0, seed);
  const b = hash(x1, y0, seed);
  const c = hash(x0, y1, seed);
  const d = hash(x1, y1, seed);
  return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;
}

function fbm(
  x: number,
  y: number,
  seed: number,
  octaves: number,
  px = 1 << 16,
  py = 1 << 16,
) {
  let sum = 0;
  let amp = 0.5;
  let norm = 0;
  for (let o = 0; o < octaves; o++) {
    sum += amp * noise(x, y, seed + o * 17, px, py);
    norm += amp;
    x *= 2;
    y *= 2;
    px *= 2;
    py *= 2;
    amp *= 0.5;
  }
  return sum / norm;
}

// --------------------------------------------------------------- textures

type RGBA = [number, number, number, number?];

// Fills `count` canvases in one pass; `pixel` returns one color per canvas.
// u, v are in [0, 1) with v = 0 at the bottom (texture convention).
function paint(
  width: number,
  height: number,
  count: number,
  pixel: (u: number, v: number) => RGBA[],
) {
  const canvases = Array.from({ length: count }, () => {
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    return canvas;
  });
  const images = canvases.map((canvas) =>
    canvas.getContext('2d')!.createImageData(width, height),
  );
  for (let y = 0; y < height; y++) {
    for (let x = 0; x < width; x++) {
      const colors = pixel((x + 0.5) / width, 1 - (y + 0.5) / height);
      const i = (y * width + x) * 4;
      for (let c = 0; c < count; c++) {
        const [r, g, b, a = 1] = colors[c];
        const data = images[c].data;
        data[i] = clamp01(r) * 255;
        data[i + 1] = clamp01(g) * 255;
        data[i + 2] = clamp01(b) * 255;
        data[i + 3] = clamp01(a) * 255;
      }
    }
  }
  canvases.forEach((canvas, c) =>
    canvas.getContext('2d')!.putImageData(images[c], 0, 0),
  );
  return canvases;
}

// A repeating texture; geometry UVs are in meters, so `meters` is the tile.
function tiled(
  canvas: HTMLCanvasElement,
  color: boolean,
  metersU: number,
  metersV = metersU,
) {
  const tex = own(new THREE.CanvasTexture(canvas));
  tex.colorSpace = color ? THREE.SRGBColorSpace : THREE.NoColorSpace;
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(1 / metersU, 1 / metersV);
  tex.anisotropy = 8;
  return tex;
}

// A texture covering a centered w x h panel (UVs in meters).
function fitted(canvas: HTMLCanvasElement, w: number, h: number) {
  const tex = own(new THREE.CanvasTexture(canvas));
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.repeat.set(1 / w, 1 / h);
  tex.offset.set(0.5, 0.5);
  tex.anisotropy = 8;
  return tex;
}

// Engineered oak: a 2 m x 4 m tile of 20 cm planks, 1-2 m long.
function oakFloor() {
  const planks = 10;
  const lengths = [2, 4 / 3, 2, 1, 4 / 3, 2, 1, 4 / 3, 2, 4 / 3]; // meters
  const shifts = lengths.map((_, i) => hash(i, 3, 7) * 4);
  const [color, rough, bump] = paint(768, 1536, 3, (u, v) => {
    const column = Math.floor(u * planks);
    const across = u * planks - column; // 0..1 across the plank
    const along = mod(v * 4 + shifts[column], 4); // meters along the column
    const row = Math.floor(along / lengths[column]);
    const end = along - row * lengths[column]; // meters into this board
    const seed = column * 31 + row * 7 + 1;
    const gap =
      Math.min(across, 1 - across) * 0.2 < 0.001 ||
      Math.min(end, lengths[column] - end) < 0.0012;
    const offset = hash(seed, 1, 2) * 50;
    const warp = fbm(across * 2 + offset, along * 0.8, seed, 3) * 9;
    const grain = 0.5 + 0.5 * Math.sin(across * 26 + warp);
    const fine = fbm(across * 40, along * 2 + offset, seed + 3, 2);
    const ray = fbm(across * 4 + offset, along * 30, seed + 9, 2);
    const tone = 0.94 + (hash(seed, 2, 9) - 0.5) * 0.12;
    const t = tone * (0.9 + 0.07 * grain + 0.06 * fine + 0.03 * ray);
    const shade = gap ? 0.55 : 1;
    // Roughness varies per board and slowly along it, not per grain line.
    const r = gap ? 0.9 : 0.45 + 0.1 * hash(seed, 4, 4) + 0.05 * fbm(across, along * 0.5 + offset, seed + 11, 2);
    const b = gap ? 0 : 0.7 + 0.12 * grain + 0.05 * fine;
    return [
      [0.8 * t * shade, 0.65 * t * shade, 0.48 * t * shade],
      [r, r, r],
      [b, b, b],
    ];
  });
  return {
    map: tiled(color, true, 2, 4),
    roughnessMap: tiled(rough, false, 2, 4),
    bumpMap: tiled(bump, false, 2, 4),
  };
}

// Fine plaster bump, 1 m tile.
function plaster() {
  const [canvas] = paint(256, 256, 1, (u, v) => {
    const b = 0.45 + 0.4 * fbm(u * 16, v * 16, 3, 4, 16, 16);
    return [[b, b, b]];
  });
  return tiled(canvas, false, 1);
}

// Woven fabric color + bump, 10 cm tile.
function fabric(seed: number) {
  const threads = 48;
  const [color, bump] = paint(256, 256, 2, (u, v) => {
    const cell = (Math.floor(u * threads) + Math.floor(v * threads)) % 2;
    const warp = Math.sin(mod(u * threads, 1) * Math.PI);
    const weft = Math.sin(mod(v * threads, 1) * Math.PI);
    const thread = cell ? warp : weft;
    const slub = fbm(u * 6, v * 48, seed, 3, 6, 48);
    const t = 0.86 + 0.08 * thread + 0.1 * slub;
    return [
      [t, t, t],
      [thread, thread, thread],
    ];
  });
  return { map: tiled(color, true, 0.1), bumpMap: tiled(bump, false, 0.1) };
}

// Walnut veneer, 1 m tile, grain along U.
function walnut() {
  const [canvas] = paint(512, 512, 1, (u, v) => {
    const warp = fbm(u * 3, v * 8, 11, 4, 3, 8) * 5;
    const ring = 0.5 + 0.5 * Math.sin((v * 90 + warp) * Math.PI);
    const pores = fbm(u * 160, v * 24, 12, 2, 160, 24);
    const t = 0.8 + 0.12 * ring + 0.1 * pores;
    return [[0.33 * t, 0.2 * t, 0.12 * t]];
  });
  return tiled(canvas, true, 1);
}

// Wool rug: ivory field, charcoal lattice and border.
function rugCanvas(w: number, h: number) {
  const [canvas] = paint(1024, Math.round((1024 * h) / w), 1, (u, v) => {
    const x = u * w;
    const y = v * h;
    const fiber =
      (fbm(x * 140, y * 140, 21, 2) - 0.5) * 0.14 +
      (fbm(x * 3, y * 3, 22, 3) - 0.5) * 0.08;
    const border = Math.min(x, w - x, y, h - y);
    const band = border > 0.1 && border < 0.13;
    const dx = Math.abs(mod(x / 0.32, 1) - 0.5);
    const dy = Math.abs(mod(y / 0.32, 1) - 0.5);
    const lattice = border > 0.2 && Math.abs(dx + dy - 0.5) < 0.025;
    if (band || lattice) return [[0.35 * (1 + fiber), 0.31 * (1 + fiber), 0.28 * (1 + fiber)]];
    const base = 0.9 + fiber;
    return [[0.9 * base, 0.87 * base, 0.8 * base]];
  });
  return canvas;
}

// Abstract painting with soft overlapping shapes.
function paintingTexture() {
  const canvas = document.createElement('canvas');
  canvas.width = 768;
  canvas.height = 512;
  const ctx = canvas.getContext('2d')!;
  ctx.fillStyle = '#e9e2d4';
  ctx.fillRect(0, 0, 768, 512);
  ctx.filter = 'blur(1.5px)';
  const shapes: [string, number, number, number][] = [
    ['#b9673f', 250, 300, 160],
    ['#2c4547', 480, 220, 180],
    ['#d7a24b', 600, 380, 100],
    ['#8d9b85', 340, 150, 110],
  ];
  for (const [fill, x, y, r] of shapes) {
    ctx.globalAlpha = 0.88;
    ctx.fillStyle = fill;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 0.85;
  ctx.strokeStyle = '#1d1d1d';
  ctx.lineWidth = 5;
  ctx.beginPath();
  ctx.moveTo(90, 420);
  ctx.bezierCurveTo(260, 130, 520, 520, 690, 100);
  ctx.stroke();
  // Canvas weave.
  const image = ctx.getImageData(0, 0, 768, 512);
  for (let i = 0; i < image.data.length; i += 4) {
    const p = i / 4;
    const weave = ((p % 768) % 3 === 0 ? -6 : 0) + (Math.floor(p / 768) % 3 === 0 ? -6 : 0);
    image.data[i] += weave;
    image.data[i + 1] += weave;
    image.data[i + 2] += weave;
  }
  ctx.putImageData(image, 0, 0);
  const tex = own(new THREE.CanvasTexture(canvas));
  tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}

// Bright, hazy view out of the window: sky, a tree line, a hedge.
function outsideTexture() {
  const [canvas] = paint(1024, 512, 1, (u, v) => {
    const sky: [number, number, number] = [mix(0.97, 0.9, v), mix(0.98, 0.94, v), mix(0.99, 0.98, v)];
    // A soft band of foliage under a clipped sky, darker towards the bottom.
    const ridge = 0.33 + 0.05 * fbm(u * 4, 0, 31, 3) + 0.02 * fbm(u * 40, v * 20, 32, 2);
    const foliage = clamp01((ridge - v) / 0.04);
    const leaf = fbm(u * 60, v * 40, 33, 4);
    const t = (0.45 + 0.6 * leaf) * mix(0.7, 1, v / 0.35);
    const haze = 0.2 * (v / 0.35);
    const green = [mix(0.42 * t, sky[0], haze), mix(0.52 * t, sky[1], haze), mix(0.36 * t, sky[2], haze)];
    return [[mix(sky[0], green[0], foliage), mix(sky[1], green[1], foliage), mix(sky[2], green[2], foliage)]];
  });
  const tex = own(new THREE.CanvasTexture(canvas));
  tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}

// Fiddle-leaf fig leaf with veins; alpha cut-out.
function leafTexture() {
  const [color, bump] = paint(256, 256, 2, (u, v) => {
    const x = (u - 0.5) * 2;
    // Violin outline: narrow base, slight waist, broad rounded tip.
    const waist = 1 - 0.12 * Math.exp(-Math.pow((v - 0.42) / 0.12, 2));
    const width = 0.96 * Math.pow(Math.sin(Math.PI * Math.pow(Math.min(v, 0.999), 0.5)), 0.6) * (0.5 + 0.5 * v) * waist;
    const inside = Math.abs(x) < width ? 1 : 0;
    const midrib = Math.abs(x) < 0.025 ? 1 : 0;
    const vein = Math.abs(mod(v * 5 - Math.abs(x) * 1.3, 1) - 0.5) < 0.03 ? 1 : 0;
    const shade = 0.82 + 0.18 * fbm(u * 6, v * 6, 41, 3);
    const edge = 1 - 0.2 * clamp01((Math.abs(x) / Math.max(width, 0.01) - 0.8) * 5);
    const light = (midrib ? 1.5 : vein ? 1.18 : 1) * edge;
    const height = midrib || vein ? 0.35 : 0.6;
    return [
      [0.19 * shade * light, 0.31 * shade * light, 0.12 * shade * light, inside],
      [height, height, height],
    ];
  });
  const map = own(new THREE.CanvasTexture(color));
  map.colorSpace = THREE.SRGBColorSpace;
  return { map, bumpMap: own(new THREE.CanvasTexture(bump)) };
}

// --------------------------------------------------------- baked lighting

// Furniture boxes (world AABBs) that occlude ambient light on room surfaces.
type Occluder = { min: THREE.Vector3; max: THREE.Vector3; strength: number };
const occluders: Occluder[] = [];
const roomPlanes = [
  { n: new THREE.Vector3(1, 0, 0), d: -X0 },
  { n: new THREE.Vector3(-1, 0, 0), d: X1 },
  { n: new THREE.Vector3(0, 1, 0), d: 0 },
  { n: new THREE.Vector3(0, -1, 0), d: H },
  { n: new THREE.Vector3(0, 0, 1), d: -Z0 },
  { n: new THREE.Vector3(0, 0, -1), d: Z1 },
];
const windowSamples: THREE.Vector3[] = [];
for (let i = 0; i < 5; i++) {
  for (let j = 0; j < 3; j++) {
    windowSamples.push(
      new THREE.Vector3(
        X0,
        SILL + ((j + 0.5) / 3) * (HEAD - SILL),
        WINDOW_Z - WINDOW_WIDTH / 2 + ((i + 0.5) / 5) * WINDOW_WIDTH,
      ),
    );
  }
}
const windowSampleArea = (WINDOW_WIDTH * (HEAD - SILL)) / windowSamples.length;
// Where sunlight through the window lands on the floor; the bright patch
// bounces warm light onto the ceiling and walls.
const SUN_POSITION = new THREE.Vector3(-8.6, 6.7, 0.25);
const SUN_TARGET = new THREE.Vector3(-0.6, 0, -1.95);
const sunDirection = SUN_TARGET.clone().sub(SUN_POSITION).normalize();
const patchSamples = windowSamples
  .map((w) => w.clone().addScaledVector(sunDirection, -w.y / sunDirection.y))
  .filter((f) => f.x > X0 && f.x < X1 && f.z > Z0 && f.z < Z1);
const patchSampleArea =
  (WINDOW_WIDTH * (HEAD - SILL) * Math.abs(sunDirection.x)) / -sunDirection.y / windowSamples.length;
const toSample = new THREE.Vector3();
const closest = new THREE.Vector3();
const center = new THREE.Vector3();

// True if the segment a -> b passes through the box (slab test).
function blocks(a: THREE.Vector3, b: THREE.Vector3, o: Occluder) {
  let t0 = 0.0001;
  let t1 = 0.9999;
  for (const axis of ['x', 'y', 'z'] as const) {
    const delta = b[axis] - a[axis];
    if (Math.abs(delta) < 1e-9) {
      if (a[axis] < o.min[axis] || a[axis] > o.max[axis]) return false;
      continue;
    }
    let near = (o.min[axis] - a[axis]) / delta;
    let far = (o.max[axis] - a[axis]) / delta;
    if (near > far) [near, far] = [far, near];
    t0 = Math.max(t0, near);
    t1 = Math.min(t1, far);
    if (t0 > t1) return false;
  }
  return true;
}

const inside = (p: THREE.Vector3, o: Occluder) =>
  p.x > o.min.x - 0.02 && p.x < o.max.x + 0.02 &&
  p.y > o.min.y - 0.02 && p.y < o.max.y + 0.02 &&
  p.z > o.min.z - 0.02 && p.z < o.max.z + 0.02;

// Ambient occlusion from room corners and nearby furniture.
function occlusion(p: THREE.Vector3, n: THREE.Vector3, active: Occluder[]) {
  let ao = 1;
  for (const plane of roomPlanes) {
    if (Math.abs(plane.n.dot(n)) > 0.5) continue;
    const distance = Math.max(0, plane.n.dot(p) + plane.d);
    ao *= (1 - 0.45 * Math.exp(-distance / 0.3)) * (1 - 0.2 * Math.exp(-distance / 0.04));
  }
  for (const o of active) {
    center.addVectors(o.min, o.max).multiplyScalar(0.5);
    if (n.dot(toSample.subVectors(center, p)) < 0) continue;
    closest.copy(p).clamp(o.min, o.max);
    const distance = closest.distanceTo(p);
    ao *= (1 - o.strength * Math.exp(-distance / 0.25)) * (1 - 0.5 * Math.exp(-distance / 0.04));
  }
  return ao;
}

// Diffuse irradiance (relative units) at p with normal n. Furniture
// vertices pass `self = true` so the volume containing them is ignored.
function irradiance(p: THREE.Vector3, n: THREE.Vector3, self = false): [number, number, number] {
  const active = self ? occluders.filter((o) => !inside(p, o)) : occluders;
  // Skylight through the window as an area light, shadowed by furniture.
  let sky = 0;
  for (const s of windowSamples) {
    toSample.subVectors(s, p);
    const d2 = Math.max(toSample.lengthSq(), 0.05);
    toSample.normalize();
    const cosP = n.dot(toSample);
    const cosW = -toSample.x;
    if (cosP <= 0 || cosW <= 0) continue;
    if (active.some((o) => blocks(p, s, o))) continue;
    sky += (cosP * cosW * windowSampleArea) / (Math.PI * d2);
  }
  // Bounce from the sun patch on the floor (a Lambertian emitter facing up).
  let patch = 0;
  for (const f of patchSamples) {
    toSample.subVectors(f, p);
    const d2 = Math.max(toSample.lengthSq(), 0.1);
    toSample.normalize();
    const cosP = n.dot(toSample);
    const cosE = -toSample.y;
    if (cosP > 0 && cosE > 0) patch += (cosP * cosE * patchSampleArea) / (Math.PI * d2);
  }
  const ao = occlusion(p, n, active);
  // Warm multi-bounce ambient: ~100 units of light enter through the window
  // and spread over ~116 m2 of surfaces with albedo ~0.6, giving ~1.3
  // irradiance (dimmer on the ceiling, which only sees bounce light).
  const bounce = (1.2 / LIGHTMAP_INTENSITY) * ao * (n.y < -0.5 ? 0.7 : 1);
  const direct = sky * (0.6 + 0.4 * ao) * 1.6;
  // Floor exitance in the patch: sun (22) x cos(elevation) x albedo (0.45).
  const warm = ((22 * -sunDirection.y * 0.45) / LIGHTMAP_INTENSITY) * patch * (Math.abs(n.y) < 0.5 && p.y < H / 2 ? 1.25 : 1);
  return [
    bounce * 1.0 + direct * 0.93 + warm,
    bounce * 0.9 + direct * 0.95 + warm * 0.85,
    bounce * 0.78 + direct * 1.0 + warm * 0.66,
  ];
}

// Bakes a half-float lightmap for a flat mesh whose UVs are its local XY in
// meters over a centered w x h rectangle.
function bakeLightmap(object: THREE.Object3D, w: number, h: number, texelsPerMeter = 24) {
  object.updateWorldMatrix(true, false);
  const width = Math.max(8, Math.round(w * texelsPerMeter));
  const height = Math.max(8, Math.round(h * texelsPerMeter));
  const data = new Uint16Array(width * height * 4);
  const normal = new THREE.Vector3(0, 0, 1).transformDirection(object.matrixWorld);
  const p = new THREE.Vector3();
  for (let y = 0; y < height; y++) {
    for (let x = 0; x < width; x++) {
      p.set(((x + 0.5) / width - 0.5) * w, ((y + 0.5) / height - 0.5) * h, 0);
      p.applyMatrix4(object.matrixWorld);
      const [r, g, b] = irradiance(p, normal);
      const i = (y * width + x) * 4;
      data[i] = THREE.DataUtils.toHalfFloat(r);
      data[i + 1] = THREE.DataUtils.toHalfFloat(g);
      data[i + 2] = THREE.DataUtils.toHalfFloat(b);
      data[i + 3] = THREE.DataUtils.toHalfFloat(1);
    }
  }
  const tex = own(new THREE.DataTexture(data, width, height, THREE.RGBAFormat, THREE.HalfFloatType));
  tex.magFilter = THREE.LinearFilter;
  tex.minFilter = THREE.LinearFilter;
  tex.repeat.set(1 / w, 1 / h);
  tex.offset.set(0.5, 0.5);
  tex.needsUpdate = true;
  return tex;
}

// ---------------------------------------------------------------- geometry

// Scales BoxGeometry UVs (0..1 per face) to meters so tiled textures keep
// their real-world size on any box.
function meterUVs(geometry: THREE.BoxGeometry, w: number, h: number, d: number) {
  const uv = geometry.getAttribute('uv');
  const perFace = uv.count / 6;
  const sizes = [
    [d, h],
    [d, h],
    [w, d],
    [w, d],
    [w, h],
    [w, h],
  ];
  for (let i = 0; i < uv.count; i++) {
    const [su, sv] = sizes[Math.floor(i / perFace)];
    uv.setXY(i, uv.getX(i) * su, uv.getY(i) * sv);
  }
  return geometry;
}

// Box with rounded edges; `puff` bulges the top/bottom faces like a cushion.
function roundedBox(w: number, h: number, d: number, r: number, puff = 0, segments = 6) {
  const geometry = own(meterUVs(new THREE.BoxGeometry(w, h, d, segments, segments, segments), w, h, d));
  const position = geometry.getAttribute('position');
  const normal = geometry.getAttribute('normal');
  const p = new THREE.Vector3();
  const inner = new THREE.Vector3();
  const n = new THREE.Vector3();
  const hx = w / 2 - r;
  const hy = h / 2 - r;
  const hz = d / 2 - r;
  for (let i = 0; i < position.count; i++) {
    p.fromBufferAttribute(position, i);
    inner.set(
      THREE.MathUtils.clamp(p.x, -hx, hx),
      THREE.MathUtils.clamp(p.y, -hy, hy),
      THREE.MathUtils.clamp(p.z, -hz, hz),
    );
    n.subVectors(p, inner).normalize();
    p.copy(inner).addScaledVector(n, r);
    if (puff) {
      const fx = Math.max(0, 1 - Math.pow(p.x / (w / 2), 2));
      const fz = Math.max(0, 1 - Math.pow(p.z / (d / 2), 2));
      p.y += Math.sign(p.y) * puff * Math.sqrt(fx * fz);
    }
    position.setXYZ(i, p.x, p.y, p.z);
    normal.setXYZ(i, n.x, n.y, n.z);
  }
  if (puff) geometry.computeVertexNormals();
  return geometry;
}

// Rectangle in the XY plane, UVs in meters, with optional rectangular holes.
function panel(w: number, h: number, holes: [number, number, number, number][] = []) {
  const shape = new THREE.Shape();
  shape.moveTo(-w / 2, -h / 2);
  shape.lineTo(w / 2, -h / 2);
  shape.lineTo(w / 2, h / 2);
  shape.lineTo(-w / 2, h / 2);
  for (const [x0, y0, x1, y1] of holes) {
    const hole = new THREE.Path();
    hole.moveTo(x0, y0);
    hole.lineTo(x0, y1);
    hole.lineTo(x1, y1);
    hole.lineTo(x1, y0);
    shape.holes.push(hole);
  }
  return own(new THREE.ShapeGeometry(shape));
}

const unitPlane = own(new THREE.PlaneGeometry(1, 1));

// --------------------------------------------------------------- materials

const standard = (params: THREE.MeshStandardMaterialParameters) =>
  own(new THREE.MeshStandardMaterial(params));

const plasterBump = plaster();
const oak = oakFloor();
const walnutMap = walnut();
const walnutMaterial = standard({ map: walnutMap, roughness: 0.5 });
const darkWalnut = standard({ map: walnutMap, color: '#8a7a70', roughness: 0.55 });
const trimMaterial = standard({ color: '#f3f1ec', roughness: 0.5 });
const blackMetal = standard({ color: '#1a1a1a', roughness: 0.4, metalness: 0.85 });
const brass = standard({ color: '#c6a062', roughness: 0.28, metalness: 1 });
const ceramic = standard({ color: '#ebe6dc', roughness: 0.3 });
const stoneware = standard({ color: '#4a4844', roughness: 0.55 });
const terracotta = standard({ color: '#a65f40', roughness: 0.85 });
const soil = standard({ color: '#2a2019', roughness: 1 });
const sofaMaterial = standard({ color: '#7f868b', roughness: 0.95, ...fabric(51), bumpScale: 0.5 });
const chairMaterial = standard({ color: '#b2643e', roughness: 0.9, ...fabric(54), bumpScale: 0.5 });
const pillowOchre = standard({ color: '#c79e68', roughness: 0.95, ...fabric(52), bumpScale: 0.5 });
const pillowLinen = standard({ color: '#e8e2d5', roughness: 0.95, ...fabric(53), bumpScale: 0.5 });
const throwMaterial = standard({ color: '#d8cfc0', roughness: 1, ...fabric(55), bumpScale: 1 });
const screenMaterial = customizeEnvironment(standard({ color: '#050506', roughness: 0.05, metalness: 0.2, envMapIntensity: 0.3 }), { boxProjected: true });
const glassMaterial = standard({ color: '#e6f0f5', roughness: 0.03, transparent: true, opacity: 0.1 });
const mirrorMaterial = customizeEnvironment(standard({ color: '#d8dcdc', roughness: 0.15, metalness: 1 }), { boxProjected: true });
const outsideMaterial = own(new THREE.MeshBasicMaterial({ map: outsideTexture() }));
outsideMaterial.color.setScalar(4); // overexposed, like a photo of a window
const curtainMaterial = standard({
  vertexColors: true,
  color: '#f5f2ea',
  roughness: 1,
  side: THREE.DoubleSide,
  transparent: true,
  opacity: 0.82,
  emissive: '#fff6e6',
  emissiveIntensity: 0.25, // backlit by the window
});
const lampShadeMaterial = standard({
  color: '#efe4cf',
  roughness: 1,
  side: THREE.DoubleSide,
  emissive: '#ffc985',
  emissiveIntensity: 1.1,
});
const bulbMaterial = own(new THREE.MeshBasicMaterial({ color: '#fff1dc' }));
bulbMaterial.color.setScalar(5);
const bookMaterial = standard({ roughness: 0.8 });
const leafMaterial = standard({
  ...leafTexture(),
  bumpScale: 0.6,
  alphaTest: 0.5,
  side: THREE.DoubleSide,
  roughness: 0.45,
  envMapIntensity: 0.12,
});
const potMaterial = standard({ color: '#e4ded3', roughness: 0.85 });
const hiddenMaterial = own(new THREE.MeshBasicMaterial({ visible: false }));

// Room surfaces get their indirect light from baked lightmaps, so their
// environment map only contributes reflections.
function shellMaterial(params: THREE.MeshStandardMaterialParameters) {
  const material = standard({ envMapIntensity: 0.5, lightMapIntensity: LIGHTMAP_INTENSITY, ...params });
  material.shadowSide = THREE.DoubleSide;
  return customizeEnvironment(material, { specularOnly: true });
}

// ----------------------------------------------------------------- helpers

type Vec3 = [number, number, number];

function mesh(
  geometry: THREE.BufferGeometry,
  material: THREE.Material,
  [x, y, z]: Vec3,
  parent: THREE.Object3D = scene,
  { cast = true, receive = true } = {},
) {
  const object = new THREE.Mesh(geometry, material);
  object.position.set(x, y, z);
  object.castShadow = cast;
  object.receiveShadow = receive;
  parent.add(object);
  return object;
}

function box([w, h, d]: Vec3, material: THREE.Material, position: Vec3, parent: THREE.Object3D = scene) {
  return mesh(own(meterUVs(new THREE.BoxGeometry(w, h, d), w, h, d)), material, position, parent);
}

function group(x: number, y: number, z: number, rotationY = 0) {
  const object = new THREE.Group();
  object.position.set(x, y, z);
  object.rotation.y = rotationY;
  scene.add(object);
  return object;
}

// Invisible furniture volume, reported as an XRMesh and used as an occluder
// for the baked lighting.
function volume(label: string, [w, h, d]: Vec3, position: Vec3, parent: THREE.Object3D, strength = 0.7) {
  const object = mesh(own(new THREE.BoxGeometry(w, h, d)), hiddenMaterial, position, parent, {
    cast: false,
    receive: false,
  });
  object.userData.xrMesh = label;
  object.updateWorldMatrix(true, false);
  const bounds = new THREE.Box3().setFromObject(object);
  occluders.push({ min: bounds.min, max: bounds.max, strength });
  return object;
}

// --------------------------------------------------------------- furniture
// Furniture is built first so its volumes shape the baked lighting.

// Sofa against the back wall.
const sofa = group(0, 0, Z0 + 0.52);
{
  const width = 2.3;
  mesh(roundedBox(width, 0.2, 0.92, 0.04), sofaMaterial, [0, 0.19, 0], sofa);
  mesh(roundedBox(width, 0.52, 0.2, 0.07), sofaMaterial, [0, 0.55, -0.36], sofa);
  for (const s of [-1, 1]) {
    mesh(roundedBox(0.2, 0.38, 0.92, 0.07, 0.008), sofaMaterial, [s * (width / 2 - 0.1), 0.45, 0], sofa);
    for (const z of [-0.36, 0.36]) {
      mesh(own(new THREE.CylinderGeometry(0.016, 0.011, 0.09, 10)), blackMetal, [s * (width / 2 - 0.08), 0.045, z], sofa, { cast: false });
    }
  }
  const seat = (width - 0.4) / 3;
  for (let i = 0; i < 3; i++) {
    const x = -width / 2 + 0.2 + seat * (i + 0.5);
    const cushion = mesh(roundedBox(seat - 0.008, 0.16, 0.68, 0.06, 0.022, 8), sofaMaterial, [x, 0.37, 0.1], sofa);
    cushion.rotation.z = (i - 1) * 0.006;
    const back = mesh(roundedBox(seat - 0.015, 0.46, 0.2, 0.09, 0.025, 8), sofaMaterial, [x, 0.66, -0.2], sofa);
    back.rotation.set(-0.2, 0, (i - 1) * 0.012);
  }
  const ochre = mesh(roundedBox(0.48, 0.48, 0.14, 0.07, 0.045, 8), pillowOchre, [-0.74, 0.67, -0.07], sofa);
  ochre.rotation.set(-0.3, 0.28, 0.14);
  const linen = mesh(roundedBox(0.44, 0.44, 0.13, 0.07, 0.04, 8), pillowLinen, [0.78, 0.66, -0.07], sofa);
  linen.rotation.set(-0.32, -0.32, -0.12);
  // Throw blanket draped over the right arm.
  const throwGeometry = own(new THREE.PlaneGeometry(0.5, 1.0, 12, 30));
  const tp = throwGeometry.getAttribute('position');
  for (let i = 0; i < tp.count; i++) {
    const tx = tp.getX(i);
    const ty = tp.getY(i) + 0.5; // 0..1 along the drape
    const angle = Math.min(ty / 0.45, 1) * Math.PI * 0.95;
    const radius = 0.11;
    const ripple = Math.sin(tx * 30 + ty * 6) * 0.008 + Math.sin(tx * 13) * 0.006;
    const y = ty < 0.45 ? Math.sin(angle) * radius : radius * Math.sin(Math.PI * 0.95) - (ty - 0.45) * 0.9;
    const z = ty < 0.45 ? -Math.cos(angle) * radius : radius * 0.98 + (ty - 0.45) * 0.08;
    tp.setXYZ(i, tx, y, z + ripple);
  }
  throwGeometry.computeVertexNormals();
  const drape = mesh(throwGeometry, throwMaterial, [width / 2 - 0.1, 0.55, 0.05], sofa);
  drape.rotation.y = Math.PI / 2;
  (drape.material as THREE.Material).side = THREE.DoubleSide;
  volume('couch', [width, 0.86, 0.94], [0, 0.43, 0], sofa, 0.85);
}

// Side table with a lit lamp, left of the sofa.
const sideTable = group(-1.55, 0, Z0 + 0.35);
{
  mesh(own(new THREE.CylinderGeometry(0.23, 0.23, 0.03, 48)), walnutMaterial, [0, 0.55, 0], sideTable);
  mesh(own(new THREE.CylinderGeometry(0.018, 0.018, 0.54, 12)), blackMetal, [0, 0.27, 0], sideTable);
  mesh(own(new THREE.CylinderGeometry(0.15, 0.16, 0.015, 32)), blackMetal, [0, 0.008, 0], sideTable);
  const base = mesh(own(new THREE.SphereGeometry(0.095, 32, 20)), ceramic, [0, 0.66, 0], sideTable);
  base.scale.y = 1.1;
  mesh(own(new THREE.CylinderGeometry(0.01, 0.01, 0.2, 8)), brass, [0, 0.82, 0], sideTable);
  mesh(own(new THREE.CylinderGeometry(0.13, 0.18, 0.25, 48, 1, true)), lampShadeMaterial, [0, 0.98, 0], sideTable, { cast: false });
  mesh(own(new THREE.SphereGeometry(0.03, 12, 8)), bulbMaterial, [0, 0.93, 0], sideTable, { cast: false, receive: false });
  const glow = new THREE.PointLight('#ffc27a', 1.4, 3.5, 2);
  glow.position.set(0, 0.95, 0);
  sideTable.add(glow);
  volume('lamp', [0.46, 1.1, 0.46], [0, 0.55, 0], sideTable, 0.5);
}

// Wall art above the sofa.
const art = group(0, 1.62, Z0);
{
  box([1.22, 0.82, 0.03], blackMetal, [0, 0, 0.015], art);
  mesh(unitPlane, trimMaterial, [0, 0, 0.0305], art, { cast: false }).scale.set(1.18, 0.78, 1);
  const canvas = mesh(unitPlane, standard({ map: paintingTexture(), roughness: 0.85 }), [0, 0, 0.031], art, { cast: false });
  canvas.scale.set(1.02, 0.66, 1);
